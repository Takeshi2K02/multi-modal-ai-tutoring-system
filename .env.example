# LLM Provider Selection
# Options: "gemini" (default) or "ollama"
LLM_PROVIDER="gemini"

# Google Gemini Configuration
# Required if LLM_PROVIDER="gemini"
GOOGLE_API_KEY="your_google_api_key_here"

# Ollama Configuration
# Required if LLM_PROVIDER="ollama"
OLLAMA_MODEL="llama3"
OLLAMA_BASE_URL="http://localhost:11434"

# Database Configuration (Optional - Defaults to Mock if missing)
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0"
